def registrar_alarma(mensaje: str):
    timestamp = datetime.datetime.now().strftime("%H:%M:%S")
    nueva_alarma = f"[{timestamp}] {mensaje}"
    if not st.session_state.historial_alarmas or st.session_state.historial_alarmas[0] != nueva_alarma:
        st.session_state.historial_alarmas.insert(0, nueva_alarma)

async def leer_servidor_opc(url: str):
    client = Client(url=url)
    try:
        async with asyncio.timeout(1.5):
            await client.connect()
            for key, meta in OPC_MAP.items():
                try:
                    var_node = client.get_node(meta["node"])
                    val = await var_node.read_value()
                    st.session_state.estado_ptap[key] = float(val)
                except Exception:
                    pass
            st.session_state.estado_ptap["opc_conectado"] = True
            st.session_state.estado_ptap["origen_datos"] = "PLC vía OPC UA"
    except Exception:
        st.session_state.estado_ptap["opc_conectado"] = False
        st.session_state.estado_ptap["origen_datos"] = "Simulación (Fallback Red)"
    finally:
        try:
            await client.disconnect()
        except Exception:
            pass

def ejecutar_logica_proceso():
    data = st.session_state.estado_ptap

    # 1. EVALUACIÓN PRIORITARIA DE FALLAS (Aplica aun si está en Modo Manual o Automático)
    if data["falla_bomba_cruda"]:
        data["bomba_cruda"] = False
        data["caudal_entrada"] = 0.0
        if data["nivel_t1"] > 5.0:
            data["nivel_t1"] = round(data["nivel_t1"] - 3.0, 2)
    else:
        data["bomba_cruda"] = True
        if not st.session_state.modo_manual:
            data["caudal_entrada"] = round(random.uniform(115.0, 125.0), 1)
            if data["nivel_t1"] < 85.0:
                data["nivel_t1"] = round(data["nivel_t1"] + 1.5, 2)

    # 2. EVALUACIÓN DEL CAUDAL DE SALIDA SEGÚN NIVEL DE T5 Y ESTADO DE B04
    if data["falla_bomba_distribucion"] or data["nivel_t5"] <= 5.0:
        data["bomba_distribucion"] = False
        data["caudal_salida"] = 0.0
    else:
        data["bomba_distribucion"] = True
        if not st.session_state.modo_manual:
            # Si hay agua en T5 y B04 funciona, hay salida independientemente de la entrada
            data["caudal_salida"] = round(random.uniform(110.0, 120.0), 1)
            # Descuento paulatino del tanque T5 si no entra agua
            if data["falla_bomba_cruda"] and data["nivel_t5"] > 5.0:
                data["nivel_t5"] = round(data["nivel_t5"] - 2.5, 2)

    # 3. OTROS ACTUADORES Y EVENTOS
    if data["falla_valvula_lodos"]:
        data["valvula_lodos"] = True
    elif not st.session_state.modo_manual:
        data["valvula_lodos"] = data["turbidez_entrada"] > 50.0

    if data["falla_valvula_filtro"] or data["sistema_obstruido"]:
        data["valvula_entrada_filtro"] = False
        if data["sistema_obstruido"]:
            data["turbidez_salida"] = 2.8
            if not st.session_state.modo_manual:
                data["caudal_salida"] = 20.0
                if data["nivel_t4"] < 98.0:
                    data["nivel_t4"] = round(data["nivel_t4"] + 4.0, 2)
    else:
        data["valvula_entrada_filtro"] = True

    if data["falla_bomba_retrolavado"]:
        data["bomba_retrolavado"] = True
    elif not data["sistema_obstruido"]:
        data["bomba_retrolavado"] = False

    if data["falla_bomba_cloro"]:
        data["bomba_dosif_cloro"] = False
        if not st.session_state.modo_manual:
            data["cloro_residual"] = round(max(0.0, data["cloro_residual"] - 0.2), 2)
    else:
        data["bomba_dosif_cloro"] = True

    # SIMULACIÓN RUIDO EN MODO AUTOMÁTICO SIN FALLAS
    if not st.session_state.modo_manual and not data["sistema_obstruido"] and not data["falla_bomba_cruda"]:
        data["turbidez_entrada"] = round(random.uniform(40.0, 55.0), 2)
        data["turbidez_salida"] = round(random.uniform(0.20, 0.40), 2)
        data["ph_floculacion"] = round(random.uniform(6.80, 7.20), 2)
        if not data["falla_bomba_cloro"]:
            data["cloro_residual"] = round(random.uniform(1.15, 1.45), 2)

    # Registro de Alarmas
    if data["ph_floculacion"] < 6.5 or data["ph_floculacion"] > 7.5:
        registrar_alarma(f"⚠️ Alarma Fisicoquímica: pH Floculador fuera de rango ({data['ph_floculacion']} UP)")
    if data["turbidez_salida"] > 1.0:
        registrar_alarma(f"🚨 Alarma Calidad: Turbidez alta en filtrado T4 ({data['turbidez_salida']} NTU)")
    if data["cloro_residual"] < 1.0:
        registrar_alarma(f"⚠️ Alarma Desinfección: Cloro residual bajo en T5 ({data['cloro_residual']} mg/L)")
    if data["caudal_entrada"] < 80.0:
        registrar_alarma(f"⚠️ Alarma Hidráulica: Caudal de captación bajo ({data['caudal_entrada']} L/s)")

def evaluacion_parametro(val, opt_min, opt_max, nombre_var):
    if val < opt_min:
        if nombre_var == "turbidez_entrada":
            sol = "Estado: Carga de sólidos baja en captación. Reducir dosificación inicial de coagulante."
        elif nombre_var == "turbidez_salida":
            sol = "Estado: Filtrado óptimo de alta clarificación."
        elif nombre_var == "ph_floculacion":
            sol = "Acción: Dosificar alcalinizante (Cal / Soda Cáustica) en Floculador T2 para coagulación óptima."
        elif nombre_var == "ph_salida":
            sol = "Acción: Ajustar pH final en T5 con alcalinizante antes de distribución a red."
        elif nombre_var == "cloro_residual":
            sol = "Acción: Incrementar dosificación de la bomba de cloro (B03) en Tanque T5."
        elif nombre_var == "caudal_entrada":
            sol = "Acción: Verificar bomba de agua cruda (B01) o limpia la rejilla de captación."
        elif nombre_var == "caudal_salida":
            sol = "Acción: Revisar nivel de Tanque T5 y estado de bomba de distribución B04."
        else:
            sol = "Acción: Revisar alimentación del proceso."
        return "warning", f"🚨 ALARMA BAJA ({val})", sol

    elif val > opt_max:
        if nombre_var == "turbidez_entrada":
            sol = "Acción: Incrementar dosificación de coagulante en T2 y abrir válvula de purga de lodos (V01) en desarenador T1."
        elif nombre_var == "turbidez_salida":
            sol = "Acción: Iniciar retrolavado inmediato con B02 en filtro T4 y verificar estado del lecho filtrante."
        elif nombre_var == "ph_floculacion":
            sol = "Acción: Inyectar acidificante / Aumentar dosis de sulfato en mezcla rápida antes de T2."
        elif nombre_var == "ph_salida":
            sol = "Acción: Reducir adición de álcali en post-tratamiento T5 para no exceder normativa de agua potable."
        elif nombre_var == "cloro_residual":
            sol = "Acción: Reducir dosificación en bomba B03 para evitar sabor/olor excesivo en red."
        elif nombre_var == "caudal_entrada":
            sol = "Acción: Estrangular válvula de entrada para evitar sobrecargar desarenador T1."
        elif nombre_var == "caudal_salida":
            sol = "Acción: Regular bombeo B04 para evitar cavitación o vaciado prematuro del tanque T5."
        else:
            sol = "Acción: Reducir flujo de alimentación."
        return "error", f"🚨 ALARMA ALTA ({val})", sol

    return "success", "🟢 RANGO NORMAL", "Operación dentro de parámetros óptimos."

def crear_gauge_tanque(titulo: str, valor: float):
    if valor < 15.0:
        color_bar = "#ff9800"
    elif valor > 90.0:
        color_bar = "#f44336"
    else:
        color_bar = "#0288d1"

    fig = go.Figure(go.Indicator(
        mode="gauge+number",
        value=valor,
        number={'suffix': "%", 'font': {'size': 16}},
        title={'text': titulo, 'font': {'size': 12}},
        gauge={
            'axis': {'range': [0, 100], 'tickwidth': 1},
            'bar': {'color': color_bar},
            'bgcolor': "#e0e0e0",
            'steps': [
                {'range': [0, 15], 'color': '#ffe0b2'},
                {'range': [15, 90], 'color': '#e1f5fe'},
                {'range': [90, 100], 'color': '#ffcdd2'}
            ],
        }
    ))
    fig.update_layout(height=150, margin=dict(l=10, r=10, t=30, b=10))
    return fig

